# ============================================================
# Christian Chapter — environment variables
# Copy this file to .env.local for local development
# All values required in production unless marked optional
# ============================================================

# PostgreSQL connection string (Neon, Supabase, or standard Postgres)
DATABASE_URL=

# Resend API key for transactional email (confirmation emails)
# Optional in development — email sending gracefully no-ops if unset
RESEND_API_KEY=

# From address for transactional emails
RESEND_FROM_EMAIL=hello@christianchapter.co.uk

# Admin dashboard password (simple auth — replace with proper auth in production)
ADMIN_PASSWORD=

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://christianchapter.co.uk

# Dev port (Replit sets this automatically)
PORT=3000
