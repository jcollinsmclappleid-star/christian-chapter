# ============================================================
# Christian Chapter — environment variables
# Copy this file to .env.local for local development
# All values required in production unless marked optional
# ============================================================

# PostgreSQL connection string (Neon). Use a connection string the
# WebSocket/Pool driver can use (not neon-http-only) so FND-07 transactions work.
# Local build: copy to .env.local, then:
#   node --env-file=.env.local ./scripts/apply-migrations.mjs
#   node --env-file=.env.local ./scripts/seed.mjs
DATABASE_URL=

# iron-session secret for cc_admin and cc_member cookies.
# Required in production: 32+ characters. Never use the dev placeholder.
SESSION_SECRET=

# Resend API key for magic-link and service email
# Optional in development — when unset, links are logged / returned as devLink
# and the UI must not claim the email was delivered.
RESEND_API_KEY=

# From address for transactional emails
RESEND_FROM_EMAIL=hello@christianchapter.co.uk

# Admin dashboard (email + password). Both required for /admin/login.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Canonical site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://christianchapter.co.uk

# Legal copy. The company default is Ianson Systems Limited if this is blank.
# The company is not VAT registered. Leave VAT_REGISTERED=false.
LEGAL_CONTACT_EMAIL=hello@christianchapter.co.uk
LEGAL_ENTITY_NAME=Ianson Systems Limited
VAT_REGISTERED=false

# Runtime for feature defaults: local | test | staging | production
CC_RUNTIME=local

# Dev port (Replit sets this automatically)
PORT=3000

# Bearer token for GET /api/cron/jobs (Vercel Cron or external scheduler). Required in production so account deletions run on schedule.
CRON_SECRET=
